# Environment for Dokploy (paste into: Service → Environment)
# Copy of .env.example plus the PaaS/hosting variables used by docker-compose.dokploy.yml.

# ── public host ───────────────────────────────────────────────
# The domain Traefik serves ARTEX on. DNS must point at the Dokploy server.
ARTEX_HOST=artex.example.com
# Traefik cert resolver name configured in Dokploy (default installation: letsencrypt)
ARTEX_CERT_RESOLVER=letsencrypt

# ── build ─────────────────────────────────────────────────────
ARTEX_VERSION=0.4.0
# runtime      = app + full recon toolbox (nmap, nuclei, httpx, subfinder, katana, ffuf,
#                dalfox, sqlmap, bbot, Playwright/Chromium). This is what agents need.
# runtime-slim = app only, ~5x faster build, agents can only do lightweight work.
ARTEX_BUILD_TARGET=runtime

# ── database (required) ───────────────────────────────────────
POSTGRES_USER=artex
POSTGRES_DB=artex
# REQUIRED — the compose file refuses to start without it. Generate with:
#   openssl rand -base64 24 | tr -dc 'A-Za-z0-9'
POSTGRES_PASSWORD=

# ── LLM (optional here; can also be set later in the UI) ──────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
